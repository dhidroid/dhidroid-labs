{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "dhidroid-labs",
    "compatibility_date": "2026-11-23",
    "assets": {
        "directory": "./out",
        "not_found_handling": "404-page"
    },
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "redact_query_string": false,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
        },
        "traces": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true
        }
    }
}
