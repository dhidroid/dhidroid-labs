# ── API route ──────────────────────────────────────────────────────────────────
# In production (Cloudflare) the bundled /api/newsletter route is used by default.
# Set this only if you want to override with an external URL.
# NEXT_PUBLIC_NEWSLETTER_API_URL=https://your-worker.workers.dev/api/newsletter

# ── Email delivery (Cloudflare / production) ───────────────────────────────────
# The production route uses Resend (https://resend.com) — no TCP sockets needed.
# Set these as Cloudflare secrets: `wrangler secret put RESEND_API_KEY` etc.
RESEND_API_KEY=re_xxxx_your_resend_api_key
MAIL_FROM=Dhidroid Labs <hello@your-domain.com>
MAIL_TO=dhinesh4668@gmail.com
SITE_ORIGIN=https://dhidroid-labs.dhidroid.workers.dev
ADMIN_KEY=

# ── Optional Sanity content source ────────────────────────────────────────────
SANITY_PROJECT_ID=pjmjgioq
SANITY_DATASET=production

# ── Firebase Analytics (public, safe to expose) ───────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Local development only (not needed in Cloudflare) ─────────────────────────
# The .dev.ts API route uses nodemailer. These vars apply only in local dev.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/local-service-account.json
SMTP_AUDIT_TO=your_email@gmail.com
